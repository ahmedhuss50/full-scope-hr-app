# Copy to .env.local and fill in from your Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://ufnobgkoeznqlpxwmvov.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service...

# Site URL used in magic-link emails; set to your deployed URL in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend transactional email — required for application + interview emails.
# Magic-link emails still go through Supabase default unless you swap SMTP (see SETUP.md).
RESEND_API_KEY=re_...
RESEND_FROM=Full Scope <noreply@fullscope.sa>

# n8n webhook (Phase 2 — wire to your n8n instance webhook URL when ready).
# Leave empty to no-op (events log to console only).
N8N_WEBHOOK_URL=
